# Copy to `.env` (git-ignored). Next.js, Prisma and the seed script all read `.env`.
# On Vercel, set these in Project → Settings → Environment Variables.

# ── App URLs ────────────────────────────────────────────────────────────────
# Member portal (main domain) and admin portal (admin subdomain).
# Local dev: open http://localhost:3000 and http://admin.localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3000

# ── Supabase (Project Settings → API) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public anon key: safe in the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER ONLY. Used for user admin, storage uploads and signed URLs.
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (Supabase → Project Settings → Database → Connection string) ──
# URL-encode special characters in the password (e.g. '@' → %40, '#' → %23).
# connect_timeout=20 avoids spurious "can't reach database" errors on slow links.
# Pooled connection (Supavisor transaction mode, port 6543) for the app at runtime.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3&pool_timeout=30&connect_timeout=20
# Direct connection (port 5432) for migrations.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connect_timeout=20

# ── Paystack (Dashboard → Settings → API Keys & Webhooks; use TEST keys) ────
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Webhook URL to set in Paystack: https://<main-domain>/api/webhooks/paystack

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty to print emails to the server console instead of sending.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM="NBCC Member Portal <no-reply@example.com>"
# Comma-separated addresses that get "new application" alerts.
ADMIN_ALERT_EMAILS=membership@example.com

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. Use a long random string.
CRON_SECRET=

# ── Demo mode ───────────────────────────────────────────────────────────────
# true = demo banner, demo login buttons, "Verify now (demo)", "Reset demo data".
# Set to false for production; all demo behaviour switches off.
DEMO_MODE=true
# Password for admin@demo.nbcc.test, staff@demo.nbcc.test and member@demo.nbcc.test.
DEMO_PASSWORD=
